# Copia este archivo como .env.local y completa los valores. .env.local NO se sube a Git.

# URL pública del sitio (sin barra final). Se usa para SEO (sitemap, canonical).
NEXT_PUBLIC_SITE_URL=https://www.tu-dominio.com

# --- Formulario de Google --------------------------------------------------
# 1. Crea el formulario en Google Forms con 4 preguntas de respuesta corta/párrafo:
#    nombre, correo, teléfono y mensaje. No debe exigir iniciar sesión.
# 2. Abre el formulario > menú ⋮ > "Obtener enlace prellenado", llena las 4 preguntas
#    con cualquier texto y copia el enlace generado. De ahí salen los códigos entry.XXXX.
# 3. GOOGLE_FORM_URL es la dirección del formulario terminada en /formResponse
#    (el enlace de respuesta, pero cambiando "viewform" por "formResponse").
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/TU_ID_DE_FORMULARIO/formResponse
GOOGLE_FORM_ENTRY_NAME=entry.0000000001
GOOGLE_FORM_ENTRY_EMAIL=entry.0000000002
GOOGLE_FORM_ENTRY_PHONE=entry.0000000003
GOOGLE_FORM_ENTRY_MESSAGE=entry.0000000004
